DATABASE_URL=postgresql://career_atlas:replace-me@localhost:5432/career_atlas
TRACKER_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
PORT=3000
NODE_ENV=development
# Web process retains this path only for the one-time SQLite migration.
DATA_DIR=./data
# Separate ingestion service:
# ROLE=worker
# APIFY_TOKEN=your-private-token
APIFY_DAILY_BUDGET_USD=0.50
APIFY_MAX_RUN_COST_USD=0.25
